rephub:Participacao rdf:type owl:Class ;
                    rdfs:subClassOf gufo:Relator ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty gufo:mediates ;
                                      owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
                                      owl:onClass gufo:Endurant
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty gufo:mediates ;
                                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass rephub:Participante
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty gufo:mediates ;
                                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass rephub:Republica
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty rephub:estabelecidaPorIngresso ;
                                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass rephub:IngressoEmRepublica
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty rephub:temSituacaoParticipacao ;
                                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass rephub:SituacaoParticipacao
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty rephub:dataEntradaParticipacao ;
                                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onDataRange xsd:dateTime
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty rephub:dataSaidaParticipacao ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onDataRange xsd:dateTime
                                    ] .


###  http://rephub#Participante
rephub:Participante rdf:type owl:Class ;
                    rdfs:subClassOf rephub:Pessoa ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty [ owl:inverseOf gufo:mediates
                                                     ] ;
                                      owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass rephub:Participacao
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty rephub:possuiConta ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass rephub:ContaDeUsuario
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty [ owl:inverseOf gufo:mediates
                                                     ] ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass [ owl:intersectionOf ( rephub:Participacao
                                                                         [ rdf:type owl:Restriction ;
                                                                           owl:onProperty rephub:temSituacaoParticipacao ;
                                                                           owl:hasValue rephub:Ativa
                                                                         ]
                                                                       ) ;
                                                    rdf:type owl:Class
                                                  ]
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty rephub:nomePessoa ;
                                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onDataRange xsd:string
                                    ] .


