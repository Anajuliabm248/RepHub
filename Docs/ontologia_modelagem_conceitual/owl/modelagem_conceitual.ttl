#################################################################
#    Classes
#################################################################

###  http://purl.org/nemo/gufo#AntiRigidType
gufo:AntiRigidType rdfs:subClassOf gufo:ConcreteIndividualType ,
                                   gufo:EndurantType ,
                                   gufo:Type .


###  http://purl.org/nemo/gufo#Aspect
gufo:Aspect rdfs:subClassOf gufo:ConcreteIndividual ,
                            gufo:Individual .


###  http://purl.org/nemo/gufo#Category
gufo:Category rdfs:subClassOf gufo:ConcreteIndividualType ,
                              gufo:EndurantType ,
                              gufo:Type .


###  http://purl.org/nemo/gufo#Collection
gufo:Collection rdfs:subClassOf gufo:ConcreteIndividual ,
                                gufo:Endurant ,
                                gufo:Individual .


###  http://purl.org/nemo/gufo#ComparativeRelationshipType
gufo:ComparativeRelationshipType rdfs:subClassOf gufo:Type ,
                                                 [ rdf:type owl:Class ;
                                                   owl:unionOf ( gufo:ComparativeRelationshipType
                                                                 gufo:MaterialRelationshipType
                                                               )
                                                 ] .


###  http://purl.org/nemo/gufo#Endurant
gufo:Endurant rdfs:subClassOf gufo:Individual .


###  http://purl.org/nemo/gufo#EndurantType
gufo:EndurantType rdfs:subClassOf gufo:Type .


###  http://purl.org/nemo/gufo#Event
gufo:Event rdfs:subClassOf gufo:Individual .


###  http://purl.org/nemo/gufo#EventType
gufo:EventType rdfs:subClassOf gufo:Type .


###  http://purl.org/nemo/gufo#ExtrinsicAspect
gufo:ExtrinsicAspect rdfs:subClassOf gufo:ConcreteIndividual ,
                                     gufo:Endurant ,
                                     gufo:Individual .


###  http://purl.org/nemo/gufo#ExtrinsicMode
gufo:ExtrinsicMode rdfs:subClassOf gufo:Aspect ,
                                   gufo:ConcreteIndividual ,
                                   gufo:Endurant ,
                                   gufo:Individual .


###  http://purl.org/nemo/gufo#FixedCollection
gufo:FixedCollection rdfs:subClassOf gufo:ConcreteIndividual ,
                                     gufo:Endurant ,
                                     gufo:Individual ,
                                     gufo:Object .


###  http://purl.org/nemo/gufo#FunctionalComplex
gufo:FunctionalComplex rdfs:subClassOf gufo:ConcreteIndividual ,
                                       gufo:Endurant ,
                                       gufo:Individual .


###  http://purl.org/nemo/gufo#IntrinsicAspect
gufo:IntrinsicAspect rdfs:subClassOf gufo:ConcreteIndividual ,
                                     gufo:Endurant ,
                                     gufo:Individual .


###  http://purl.org/nemo/gufo#IntrinsicMode
gufo:IntrinsicMode rdfs:subClassOf gufo:Aspect ,
                                   gufo:ConcreteIndividual ,
                                   gufo:Endurant ,
                                   gufo:Individual ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty gufo:inheresIn ;
                                     owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onClass gufo:ConcreteIndividual
                                   ] .


###  http://purl.org/nemo/gufo#Kind
gufo:Kind rdfs:subClassOf gufo:ConcreteIndividualType ,
                          gufo:EndurantType ,
                          gufo:Type .


###  http://purl.org/nemo/gufo#MaterialRelationshipType
gufo:MaterialRelationshipType rdfs:subClassOf gufo:Type ,
                                              [ rdf:type owl:Class ;
                                                owl:unionOf ( gufo:ComparativeRelationshipType
                                                              gufo:MaterialRelationshipType
                                                            )
                                              ] .


###  http://purl.org/nemo/gufo#Mixin
gufo:Mixin rdfs:subClassOf gufo:ConcreteIndividualType ,
                           gufo:EndurantType ,
                           gufo:NonRigidType ,
                           gufo:Type .


###  http://purl.org/nemo/gufo#NonRigidType
gufo:NonRigidType rdfs:subClassOf gufo:ConcreteIndividualType ,
                                  gufo:Type .


###  http://purl.org/nemo/gufo#NonSortal
gufo:NonSortal rdfs:subClassOf gufo:ConcreteIndividualType ,
                               gufo:Type .


###  http://purl.org/nemo/gufo#Object
gufo:Object rdfs:subClassOf gufo:ConcreteIndividual ,
                            gufo:Individual .


###  http://purl.org/nemo/gufo#Participation
gufo:Participation rdfs:subClassOf gufo:ConcreteIndividual ,
                                   gufo:Individual .


###  http://purl.org/nemo/gufo#Phase
gufo:Phase rdfs:subClassOf gufo:ConcreteIndividualType ,
                           gufo:EndurantType ,
                           gufo:NonRigidType ,
                           gufo:Type .


###  http://purl.org/nemo/gufo#PhaseMixin
gufo:PhaseMixin rdfs:subClassOf gufo:ConcreteIndividualType ,
                                gufo:EndurantType ,
                                gufo:NonRigidType ,
                                gufo:Type .


###  http://purl.org/nemo/gufo#Quality
gufo:Quality rdfs:subClassOf gufo:Aspect ,
                             gufo:ConcreteIndividual ,
                             gufo:Endurant ,
                             gufo:Individual ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty gufo:inheresIn ;
                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                               owl:onClass gufo:ConcreteIndividual
                             ] .


###  http://purl.org/nemo/gufo#QualityValue
