rephub:Administrador rdfs:label "Administrador"@pt .


rephub:AtribuicaoDeTarefa rdfs:label "Atribuição de tarefa"@pt .


rephub:Aviso rephub:regraDeNegocio "A3: autoria, destino e participação que realiza a publicação devem referir-se à mesma república. A igualdade de caminhos requer regra ou validação adicional."@pt ;
             rdfs:label "Aviso"@pt .


rephub:CategoriaDespesa rdfs:label "Categoria de despesa"@pt .


rephub:ConsultaDeExtratoFinanceiro rdfs:label "Consulta de extrato financeiro"@pt .


rephub:ContaDeUsuario rdfs:label "Conta de usuário"@pt .


rephub:Convite rdfs:label "Convite para ingresso"@pt .


rephub:Despesa rdfs:label "Despesa"@pt .


rephub:DivisaoDeDespesa rephub:regraDeNegocio "A5: critério, república, participantes considerados, parcelas produzidas e soma dos valores devem ser consistentes com a despesa. A igualdade entre coleções e a soma aritmética exigem regra ou validação adicional."@pt ;
                        rdfs:label "Divisão de despesa"@pt .


rephub:ExtratoFinanceiro rephub:regraDeNegocio "A consulta que obtém o extrato deve referir-se à mesma república e ao mesmo período. A seleção temporal dos itens reunidos é realizada por consulta ou regra."@pt ;
                         rdfs:label "Extrato financeiro"@pt .


rephub:FormaDivisao rdfs:label "Forma de divisão"@pt .


rephub:FormaPagamento rdfs:label "Forma de pagamento"@pt .


rephub:IngressoEmRepublica rephub:regraDeNegocio "Quando utiliza convite, a pessoa, a república e a participação devem coincidir com as do convite. A igualdade de caminhos requer regra ou validação adicional."@pt ;
                           rdfs:label "Ingresso em república"@pt .


rephub:Morador rdfs:label "Morador"@pt .


rephub:Pagamento rdfs:label "Pagamento"@pt .


rephub:ParcelaIndividual rephub:regraDeNegocio "A4: a despesa de origem, a participação destinatária e os indivíduos mediados pela parcela devem pertencer ao mesmo contexto. A6: valor pago, valor restante e situação são derivados dos registros confirmados e exigem cálculo externo a OWL 2 DL."@pt ;
                         rdfs:label "Parcela individual"@pt .


rephub:Participacao rephub:regraDeNegocio "A1: cada participação medeia exatamente um participante e exatamente uma república."@pt ;
                    rdfs:label "Participação em república"@pt .


rephub:Participante rephub:regraDeNegocio "A1: participante possui ao menos uma participação e, no máximo, uma participação ativa em um mesmo instante."@pt ;
                    rdfs:label "Participante"@pt .


rephub:PeriodoConsulta rephub:regraDeNegocio "A data inicial não pode ser posterior à data final; comparação entre literais temporais requer validação adicional."@pt ;
                       rdfs:label "Período de consulta"@pt .


rephub:Pessoa rdfs:label "Pessoa"@pt .


rephub:PublicacaoDeAviso rdfs:label "Publicação de aviso"@pt .


rephub:RegistroDeDespesa rdfs:label "Registro de despesa"@pt .


rephub:RegistroDePagamento rdfs:label "Registro de pagamento"@pt .


rephub:RegistroDePagamentoRealizado rdfs:label "Registro de pagamento realizado"@pt .


rephub:Republica rdfs:label "República"@pt .


rephub:SituacaoConvite rdfs:label "Situação do convite"@pt .


rephub:SituacaoPagamento rdfs:label "Situação do registro de pagamento"@pt .


rephub:SituacaoParcela rdfs:label "Situação da parcela"@pt .


rephub:SituacaoParticipacao rdfs:label "Situação da participação"@pt .


rephub:SituacaoTarefa rdfs:label "Situação da tarefa"@pt .


rephub:TarefaDomestica rephub:regraDeNegocio "A2: a participação responsável deve mediar o mesmo participante e a mesma república da tarefa e estar ativa no momento da atribuição. A coincidência de caminhos e a condição temporal requerem regra ou validação adicional."@pt ;
                       rdfs:label "Tarefa doméstica"@pt .


