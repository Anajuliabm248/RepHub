@prefix : <http://rephub#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix gufo: <http://purl.org/nemo/gufo#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rephub: <http://rephub#> .
@base <http://rephub#> .

<http://rephub> rdf:type owl:Ontology ;
                 owl:imports gufo: ;
                 <http://purl.org/dc/elements/1.1/creator> "Ana Júlia Bock Medina" ;
                 <http://purl.org/dc/elements/1.1/title> "Parte 2 do trabalho de ontologia e modelagem conceitual" ;
                 rdfs:label "Ontologia baseada no diagrama UML de um sistema de gestão de repúblicas e moradias compartilhadas" .

#################################################################
#    Annotation properties
#################################################################

###  http://rephub#regraDeNegocio
rephub:regraDeNegocio rdf:type owl:AnnotationProperty ;
                      rdfs:label "regra de negócio"@pt .


###  http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled
<http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled> rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://purl.org/nemo/gufo#broughtAbout
gufo:broughtAbout rdfs:domain gufo:ConcreteIndividual ,
                              gufo:Individual ;
                  rdfs:range gufo:ConcreteIndividual ,
                             gufo:Individual .


###  http://purl.org/nemo/gufo#categorizes
gufo:categorizes rdfs:domain gufo:Type ,
                             [ rdf:type owl:Class ;
                               owl:complementOf gufo:AbstractIndividualType
                             ] ,
                             [ rdf:type owl:Class ;
                               owl:complementOf gufo:ConcreteIndividualType
                             ] .


###  http://purl.org/nemo/gufo#concernsConstitutedEndurant
gufo:concernsConstitutedEndurant rdfs:domain gufo:ConcreteIndividual ,
                                             gufo:Individual ,
                                             gufo:Situation ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty gufo:concernsConstitutedEndurant ;
                                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onClass gufo:Object
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty [ owl:inverseOf gufo:standsInQualifiedConstitution
                                                              ] ;
                                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onClass gufo:Object
                                             ] ;
                                 rdfs:range gufo:ConcreteIndividual ,
                                            gufo:Individual .


###  http://purl.org/nemo/gufo#concernsNonRigidType
gufo:concernsNonRigidType rdfs:domain gufo:ConcreteIndividual ,
                                      gufo:Individual ,
                                      gufo:Situation ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty gufo:concernsNonRigidType ;
                                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass gufo:NonRigidType
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty [ owl:inverseOf gufo:standsInQualifiedInstantiation
                                                       ] ;
                                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass gufo:Endurant
                                      ] ;
                          rdfs:range gufo:ConcreteIndividualType ,
                                     gufo:EndurantType ,
                                     gufo:Type .


###  http://purl.org/nemo/gufo#concernsQualityType
gufo:concernsQualityType rdfs:domain gufo:ConcreteIndividual ,
                                     gufo:Individual ,
                                     gufo:Situation ,
                                     [ rdf:type owl:Class ;
                                       owl:unionOf ( [ rdf:type owl:Restriction ;
                                                       owl:onProperty gufo:concernsReifiedQualityValue ;
                                                       owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                       owl:onClass gufo:QualityValue
                                                     ]
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty gufo:concernsQualityValue ;
                                                       owl:cardinality "1"^^xsd:nonNegativeInteger
                                                     ]
                                                   )
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty gufo:concernsQualityType ;
                                       owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass gufo:EndurantType
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty [ owl:inverseOf gufo:standsInQualifiedAttribution
                                                      ] ;
                                       owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass gufo:Endurant
                                     ] ;
                         rdfs:range gufo:ConcreteIndividualType ,
                                    gufo:Type .


###  http://purl.org/nemo/gufo#concernsReifiedQualityValue
gufo:concernsReifiedQualityValue rdfs:domain gufo:ConcreteIndividual ,
                                             gufo:Individual ,
                                             gufo:Situation ,
                                             [ rdf:type owl:Class ;
                                               owl:unionOf ( [ rdf:type owl:Restriction ;
                                                               owl:onProperty gufo:concernsReifiedQualityValue ;
                                                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                               owl:onClass gufo:QualityValue
                                                             ]
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty gufo:concernsQualityValue ;
                                                               owl:cardinality "1"^^xsd:nonNegativeInteger
                                                             ]
                                                           )
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty gufo:concernsQualityType ;
                                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onClass gufo:EndurantType
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty [ owl:inverseOf gufo:standsInQualifiedAttribution
                                                              ] ;
                                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onClass gufo:Endurant
                                             ] ;
                                 rdfs:range gufo:AbstractIndividual ,
                                            gufo:Individual .


###  http://purl.org/nemo/gufo#concernsRelatedEndurant
gufo:concernsRelatedEndurant rdfs:domain gufo:ConcreteIndividual ,
                                         gufo:Individual ,
                                         gufo:Situation ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty gufo:concernsRelatedEndurant ;
                                           owl:someValuesFrom gufo:Endurant
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty gufo:concernsRelationshipType ;
                                           owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass gufo:RelationshipType
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty [ owl:inverseOf gufo:standsInQualifiedRelationship
                                                          ] ;
                                           owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass gufo:Endurant
                                         ] ;
                             rdfs:range gufo:ConcreteIndividual ,
                                        gufo:Individual .


###  http://purl.org/nemo/gufo#concernsRelationshipType
gufo:concernsRelationshipType rdfs:domain gufo:ConcreteIndividual ,
                                          gufo:Individual ,
                                          gufo:Situation ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty gufo:concernsRelatedEndurant ;
                                            owl:someValuesFrom gufo:Endurant
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty gufo:concernsRelationshipType ;
                                            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onClass gufo:RelationshipType
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty [ owl:inverseOf gufo:standsInQualifiedRelationship
                                                           ] ;
                                            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onClass gufo:Endurant
                                          ] ;
                              rdfs:range gufo:Type .


###  http://purl.org/nemo/gufo#concernsTemporaryWhole
gufo:concernsTemporaryWhole rdfs:domain gufo:ConcreteIndividual ,
                                        gufo:Individual ,
                                        gufo:Situation ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty gufo:concernsTemporaryWhole ;
                                          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass gufo:Endurant
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty [ owl:inverseOf gufo:standsInQualifiedParthood
                                                         ] ;
                                          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass gufo:Endurant
                                        ] ;
                            rdfs:range gufo:ConcreteIndividual ,
                                       gufo:Individual .


###  http://purl.org/nemo/gufo#constitutes
gufo:constitutes rdfs:domain gufo:Individual ;
                 rdfs:range gufo:Individual .


###  http://purl.org/nemo/gufo#contributedToTrigger
gufo:contributedToTrigger rdfs:domain gufo:ConcreteIndividual ,
                                      gufo:Individual ;
                          rdfs:range gufo:ConcreteIndividual ,
                                     gufo:Individual .


###  http://purl.org/nemo/gufo#externallyDependsOn
gufo:externallyDependsOn rdfs:domain gufo:Aspect ,
                                     gufo:ConcreteIndividual ,
                                     gufo:Endurant ,
                                     gufo:ExtrinsicAspect ,
                                     gufo:Individual ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty gufo:externallyDependsOn ;
                                       owl:someValuesFrom gufo:ConcreteIndividual
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty gufo:inheresIn ;
                                       owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass gufo:ConcreteIndividual
                                     ] ;
                         rdfs:range gufo:ConcreteIndividual ,
                                    gufo:Individual .


###  http://purl.org/nemo/gufo#hasAssociatedQualityValueType
gufo:hasAssociatedQualityValueType rdfs:domain gufo:ConcreteIndividualType ,
                                               gufo:Type ;
                                   rdfs:range gufo:Type .


###  http://purl.org/nemo/gufo#hasBeginPoint
gufo:hasBeginPoint rdfs:domain gufo:Individual ;
                   rdfs:range gufo:AbstractIndividual ,
                              gufo:Individual .


###  http://purl.org/nemo/gufo#hasEndPoint
gufo:hasEndPoint rdfs:domain gufo:Individual ;
                 rdfs:range gufo:AbstractIndividual ,
                            gufo:Individual .


###  http://purl.org/nemo/gufo#hasReifiedQualityValue
gufo:hasReifiedQualityValue rdfs:domain gufo:Individual ;
                            rdfs:range gufo:AbstractIndividual ,
                                       gufo:Individual .


###  http://purl.org/nemo/gufo#historicallyDependsOn
gufo:historicallyDependsOn rdfs:domain gufo:Individual ;
                           rdfs:range gufo:Individual .


###  http://purl.org/nemo/gufo#inheresIn
gufo:inheresIn rdfs:domain gufo:ConcreteIndividual ,
                           gufo:Endurant ,
                           gufo:Individual ;
               rdfs:range gufo:Individual .


###  http://purl.org/nemo/gufo#isAspectProperPartOf
gufo:isAspectProperPartOf rdfs:domain gufo:ConcreteIndividual ,
                                      gufo:Endurant ,
                                      gufo:Individual ;
                          rdfs:range gufo:ConcreteIndividual ,
                                     gufo:Endurant ,
                                     gufo:Individual .


###  http://purl.org/nemo/gufo#isCollectionMemberOf
gufo:isCollectionMemberOf rdfs:subPropertyOf gufo:isProperPartOf ;
                          rdfs:domain gufo:ConcreteIndividual ,
                                      gufo:Endurant ,
                                      gufo:Individual ;
                          rdfs:range gufo:ConcreteIndividual ,
                                     gufo:Endurant ,
                                     gufo:Individual ,
                                     gufo:Object .


###  http://purl.org/nemo/gufo#isComponentOf
gufo:isComponentOf rdfs:subPropertyOf gufo:isProperPartOf ;
                   rdfs:domain gufo:ConcreteIndividual ,
                               gufo:Endurant ,
                               gufo:Individual ;
                   rdfs:range gufo:ConcreteIndividual ,
                              gufo:Endurant ,
                              gufo:Individual ,
                              gufo:Object .


###  http://purl.org/nemo/gufo#isDerivedFrom
gufo:isDerivedFrom rdfs:range gufo:ConcreteIndividualType ,
                              gufo:Type .


###  http://purl.org/nemo/gufo#isEventProperPartOf
gufo:isEventProperPartOf rdfs:domain gufo:ConcreteIndividual ,
                                     gufo:Individual ;
                         rdfs:range gufo:ConcreteIndividual ,
                                    gufo:Individual .


###  http://purl.org/nemo/gufo#isObjectProperPartOf
gufo:isObjectProperPartOf rdfs:domain gufo:ConcreteIndividual ,
                                      gufo:Endurant ,
                                      gufo:Individual ;
                          rdfs:range gufo:ConcreteIndividual ,
                                     gufo:Endurant ,
                                     gufo:Individual .


###  http://purl.org/nemo/gufo#isSituationProperPartOf
gufo:isSituationProperPartOf rdfs:domain gufo:ConcreteIndividual ,
                                         gufo:Individual ;
                             rdfs:range gufo:ConcreteIndividual ,
                                        gufo:Individual .


###  http://purl.org/nemo/gufo#isSubCollectionOf
gufo:isSubCollectionOf rdfs:subPropertyOf gufo:isProperPartOf ;
                       rdfs:domain gufo:ConcreteIndividual ,
                                   gufo:Endurant ,
                                   gufo:Individual ,
                                   gufo:Object ;
                       rdfs:range gufo:ConcreteIndividual ,
                                  gufo:Endurant ,
                                  gufo:Individual ,
                                  gufo:Object .


###  http://purl.org/nemo/gufo#isSubQuantityOf
gufo:isSubQuantityOf rdfs:subPropertyOf gufo:isProperPartOf ;
                     rdfs:domain gufo:ConcreteIndividual ,
                                 gufo:Endurant ,
                                 gufo:Individual ,
                                 gufo:Object ;
                     rdfs:range gufo:ConcreteIndividual ,
                                gufo:Endurant ,
                                gufo:Individual ,
                                gufo:Object .


###  http://purl.org/nemo/gufo#manifestedIn
gufo:manifestedIn rdfs:domain gufo:ConcreteIndividual ,
                              gufo:Endurant ,
                              gufo:Individual ;
                  rdfs:range gufo:ConcreteIndividual ,
                             gufo:Individual .


###  http://purl.org/nemo/gufo#mediates
gufo:mediates rdfs:domain gufo:Aspect ,
                          gufo:ConcreteIndividual ,
                          gufo:Endurant ,
                          gufo:ExtrinsicAspect ,
                          gufo:Individual ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty gufo:mediates ;
                            owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
                            owl:onClass gufo:Endurant
                          ] ;
              rdfs:range gufo:ConcreteIndividual ,
                         gufo:Individual .


###  http://purl.org/nemo/gufo#participatedIn
gufo:participatedIn rdfs:domain gufo:ConcreteIndividual ,
                                gufo:Endurant ,
                                gufo:Individual ;
                    rdfs:range gufo:ConcreteIndividual ,
                               gufo:Individual .


###  http://purl.org/nemo/gufo#partitions
gufo:partitions rdfs:domain gufo:Type ,
                            [ rdf:type owl:Class ;
                              owl:complementOf gufo:AbstractIndividualType
                            ] ,
                            [ rdf:type owl:Class ;
                              owl:complementOf gufo:ConcreteIndividualType
                            ] ;
                rdfs:range gufo:Type .


###  http://purl.org/nemo/gufo#standsIn
gufo:standsIn rdfs:range gufo:ConcreteIndividual ,
                         gufo:Individual .


###  http://purl.org/nemo/gufo#standsInQualifiedAttribution
gufo:standsInQualifiedAttribution rdfs:domain gufo:ConcreteIndividual ,
                                              gufo:Individual ;
                                  rdfs:range gufo:ConcreteIndividual ,
                                             gufo:Individual ,
                                             gufo:Situation ,
                                             [ rdf:type owl:Class ;
                                               owl:unionOf ( [ rdf:type owl:Restriction ;
                                                               owl:onProperty gufo:concernsReifiedQualityValue ;
                                                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                               owl:onClass gufo:QualityValue
                                                             ]
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty gufo:concernsQualityValue ;
                                                               owl:cardinality "1"^^xsd:nonNegativeInteger
                                                             ]
                                                           )
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty gufo:concernsQualityType ;
                                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onClass gufo:EndurantType
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty [ owl:inverseOf gufo:standsInQualifiedAttribution
                                                              ] ;
                                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onClass gufo:Endurant
                                             ] .


###  http://purl.org/nemo/gufo#standsInQualifiedConstitution
gufo:standsInQualifiedConstitution rdfs:domain gufo:ConcreteIndividual ,
                                               gufo:Individual ;
                                   rdfs:range gufo:ConcreteIndividual ,
                                              gufo:Individual ,
                                              gufo:Situation ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty gufo:concernsConstitutedEndurant ;
                                                owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                owl:onClass gufo:Object
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty [ owl:inverseOf gufo:standsInQualifiedConstitution
                                                               ] ;
                                                owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                owl:onClass gufo:Object
                                              ] .


###  http://purl.org/nemo/gufo#standsInQualifiedInstantiation
gufo:standsInQualifiedInstantiation rdfs:domain gufo:ConcreteIndividual ,
                                                gufo:Individual ;
                                    rdfs:range gufo:ConcreteIndividual ,
                                               gufo:Individual ,
                                               gufo:Situation ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty gufo:concernsNonRigidType ;
                                                 owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                 owl:onClass gufo:NonRigidType
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty [ owl:inverseOf gufo:standsInQualifiedInstantiation
                                                                ] ;
                                                 owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                 owl:onClass gufo:Endurant
                                               ] .


###  http://purl.org/nemo/gufo#standsInQualifiedParthood
gufo:standsInQualifiedParthood rdfs:domain gufo:ConcreteIndividual ,
                                           gufo:Individual ;
                               rdfs:range gufo:ConcreteIndividual ,
                                          gufo:Individual ,
                                          gufo:Situation ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty gufo:concernsTemporaryWhole ;
                                            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onClass gufo:Endurant
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty [ owl:inverseOf gufo:standsInQualifiedParthood
                                                           ] ;
                                            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onClass gufo:Endurant
                                          ] .


###  http://purl.org/nemo/gufo#standsInQualifiedRelationship
gufo:standsInQualifiedRelationship rdfs:domain gufo:ConcreteIndividual ,
                                               gufo:Individual ;
                                   rdfs:range gufo:ConcreteIndividual ,
                                              gufo:Individual ,
                                              gufo:Situation ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty gufo:concernsRelatedEndurant ;
                                                owl:someValuesFrom gufo:Endurant
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty gufo:concernsRelationshipType ;
                                                owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                owl:onClass gufo:RelationshipType
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty [ owl:inverseOf gufo:standsInQualifiedRelationship
                                                               ] ;
                                                owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                owl:onClass gufo:Endurant
                                              ] .


###  http://purl.org/nemo/gufo#wasCreatedIn
gufo:wasCreatedIn rdfs:domain gufo:ConcreteIndividual ,
                              gufo:Individual ;
                  rdfs:range gufo:ConcreteIndividual ,
                             gufo:Individual .


###  http://purl.org/nemo/gufo#wasTerminatedIn
gufo:wasTerminatedIn rdfs:domain gufo:ConcreteIndividual ,
                                 gufo:Individual ;
                     rdfs:range gufo:ConcreteIndividual ,
                                gufo:Individual .


###  http://rephub#atribuiTarefa
rephub:atribuiTarefa rdf:type owl:ObjectProperty ;
                     owl:inverseOf rephub:atribuidaPorEvento ;
                     rdf:type owl:FunctionalProperty ;
                     rdfs:domain gufo:Event ,
                                 rephub:AtribuicaoDeTarefa ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty rephub:atribuiTarefa ;
                                   owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onClass rephub:TarefaDomestica
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty rephub:designaResponsavel ;
                                   owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onClass rephub:Participacao
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty rephub:realizadoPorParticipacao ;
                                   owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onClass rephub:Participacao
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty rephub:dataAtribuicaoTarefa ;
                                   owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onDataRange xsd:dateTime
                                 ] ;
                     rdfs:range rephub:TarefaDomestica ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty gufo:mediates ;
                                  owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
                                  owl:onClass gufo:Endurant
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty gufo:mediates ;
                                  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass rephub:Participante
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty gufo:mediates ;
                                  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass rephub:Republica
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty rephub:atribuidaPorEvento ;
                                  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass rephub:AtribuicaoDeTarefa
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty rephub:temResponsavel ;
                                  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass rephub:Participacao
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty rephub:temSituacaoTarefa ;
                                  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass rephub:SituacaoTarefa
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty rephub:prazoTarefa ;
                                  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onDataRange xsd:dateTime
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty rephub:tituloTarefa ;
                                  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onDataRange xsd:string
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty rephub:descricaoTarefa ;
                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onDataRange xsd:string
                                ] ;
                     rdfs:label "atribui tarefa"@pt .


###  http://rephub#atribuidaA
rephub:atribuidaA rdf:type owl:ObjectProperty ;
                  owl:inverseOf rephub:recebeParcela ;
                  rdf:type owl:FunctionalProperty ;
                  rdfs:domain gufo:Relator ,
                              rephub:ParcelaIndividual ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty gufo:mediates ;
                                owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
                                owl:onClass gufo:Endurant
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty gufo:mediates ;
                                owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onClass rephub:Participante
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty gufo:mediates ;
