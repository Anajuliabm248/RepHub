                                       owl:onProperty rephub:atribuidaPorEvento ;
                                       owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass rephub:AtribuicaoDeTarefa
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty rephub:temResponsavel ;
                                       owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass rephub:Participacao
                                     ] ,
