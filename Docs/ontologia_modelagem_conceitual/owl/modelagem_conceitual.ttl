                                       owl:onClass rephub:ContaDeUsuario
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty [ owl:inverseOf gufo:mediates
                                                      ] ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass [ owl:intersectionOf ( rephub:Participacao
                                                                          [ rdf:type owl:Restriction ;
                                                                            owl:onProperty rephub:temSituacaoParticipacao ;
                                                                            owl:hasValue rephub:Ativa
                                                                          ]
                                                                        ) ;
